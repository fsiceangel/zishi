[{"id":"1a-01","book":"1a","lesson":"1a-g1","page":16,"src":"园地","title":"咏鹅","titlePy":"yǒng é","author":"骆宾王","authorPy":"luò bīn wáng","dynasty":"唐","type":"诗","preface":null,"lines":["鹅，鹅，鹅，","曲项向天歌。","白毛浮绿水，","红掌拨清波。"],"py":[["é","é","é"],["qū","xiàng","xiàng","tiān","gē"],["bái","máo","fú","lǜ","shuǐ"],["hóng","zhǎng","bō","qīng","bō"]]},{"id":"1a-02","book":"1a","lesson":"1a-k3","page":58,"src":"课文","title":"江南","titlePy":"jiāng nán","author":"汉乐府","authorPy":"hàn yuè fǔ","dynasty":"汉","type":"诗","preface":null,"lines":["江南可采莲，","莲叶何田田。","鱼戏莲叶间。","鱼戏莲叶东，","鱼戏莲叶西，","鱼戏莲叶南，","鱼戏莲叶北。"],"py":[["jiāng","nán","kě","cǎi","lián"],["lián","yè","hé","tián","tián"],["yú","xì","lián","yè","jiān"],["yú","xì","lián","yè","dōng"],["yú","xì","lián","yè","xī"],["yú","xì","lián","yè","nán"],["yú","xì","lián","yè","běi"]]},{"id":"1a-03","book":"1a","lesson":"1a-s6","page":67,"src":"课文","title":"画","titlePy":"huà","author":"","authorPy":"","dynasty":"","type":"诗","preface":null,"lines":["远看山有色，","近听水无声。","春去花还在，","人来鸟不惊。"],"py":[["yuǎn","kàn","shān","yǒu","sè"],["jìn","tīng","shuǐ","wú","shēng"],["chūn","qù","huā","hái","zài"],["rén","lái","niǎo","bù","jīng"]]},{"id":"1a-04","book":"1a","lesson":"1a-g5","page":77,"src":"园地","title":"悯农（其二）","titlePy":"mǐn nóng （qí èr）","author":"李绅","authorPy":"lǐ shēn","dynasty":"唐","type":"诗","preface":null,"lines":["锄禾日当午，","汗滴禾下土。","谁知盘中餐，","粒粒皆辛苦。"],"py":[["chú","hé","rì","dāng","wǔ"],["hàn","dī","hé","xià","tǔ"],["shuí","zhī","pán","zhōng","cān"],["lì","lì","jiē","xīn","kǔ"]]},{"id":"1a-05","book":"1a","lesson":"1a-g6","page":91,"src":"园地","title":"古朗月行（节选）","titlePy":"gǔ lǎng yuè xíng （jié xuǎn）","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["小时不识月，","呼作白玉盘。","又疑瑶台镜，","飞在青云端。"],"py":[["xiǎo","shí","bù","shí","yuè"],["hū","zuò","bái","yù","pán"],["yòu","yí","yáo","tái","jìng"],["fēi","zài","qīng","yún","duān"]]},{"id":"1a-06","book":"1a","lesson":"1a-g8","page":113,"src":"园地","title":"风","titlePy":"fēng","author":"李峤","authorPy":"lǐ jiào","dynasty":"唐","type":"诗","preface":null,"lines":["解落三秋叶，","能开二月花。","过江千尺浪，","入竹万竿斜。"],"py":[["jiě","luò","sān","qiū","yè"],["néng","kāi","èr","yuè","huā"],["guò","jiāng","qiān","chǐ","làng"],["rù","zhú","wàn","gān","xié"]]},{"id":"1b-01","book":"1b","lesson":"1b-g2","page":27,"src":"园地","title":"春晓","titlePy":"chūn xiǎo","author":"孟浩然","authorPy":"mèng hào rán","dynasty":"唐","type":"诗","preface":null,"lines":["春眠不觉晓，","处处闻啼鸟。","夜来风雨声，","花落知多少。"],"py":[["chūn","mián","bù","jué","xiǎo"],["chù","chù","wén","tí","niǎo"],["yè","lái","fēng","yǔ","shēng"],["huā","luò","zhī","duō","shǎo"]]},{"id":"1b-02","book":"1b","lesson":"1b-g3","page":40,"src":"园地","title":"赠汪伦","titlePy":"zèng wāng lún","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["李白乘舟将欲行，","忽闻岸上踏歌声。","桃花潭水深千尺，","不及汪伦送我情。"],"py":[["lǐ","bái","chéng","zhōu","jiāng","yù","xíng"],["hū","wén","àn","shàng","tà","gē","shēng"],["táo","huā","tán","shuǐ","shēn","qiān","chǐ"],["bù","jí","wāng","lún","sòng","wǒ","qíng"]]},{"id":"1b-03","book":"1b","lesson":"1b-k8","page":43,"src":"课文","title":"静夜思","titlePy":"jìng yè sī","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["床前明月光，","疑是地上霜。","举头望明月，","低头思故乡。"],"py":[["chuáng","qián","míng","yuè","guāng"],["yí","shì","dì","shàng","shuāng"],["jǔ","tóu","wàng","míng","yuè"],["dī","tóu","sī","gù","xiāng"]]},{"id":"1b-04","book":"1b","lesson":"1b-g4","page":52,"src":"园地","title":"寻隐者不遇","titlePy":"xún yǐn zhě bù yù","author":"贾岛","authorPy":"jiǎ dǎo","dynasty":"唐","type":"诗","preface":null,"lines":["松下问童子，","言师采药去。","只在此山中，","云深不知处。"],"py":[["sōng","xià","wèn","tóng","zǐ"],["yán","shī","cǎi","yào","qù"],["zhǐ","zài","cǐ","shān","zhōng"],["yún","shēn","bù","zhī","chù"]]},{"id":"1b-05","book":"1b","lesson":"1b-k12","page":67,"src":"课文","title":"池上","titlePy":"chí shàng","author":"白居易","authorPy":"bái jū yì","dynasty":"唐","type":"诗","preface":null,"lines":["小娃撑小艇，","偷采白莲回。","不解藏踪迹，",