,"yīng","fēi","èr","yuè","tiān"],["fú","dī","yáng","liǔ","zuì","chūn","yān"],["ér","tóng","sàn","xué","guī","lái","zǎo"],["máng","chèn","dōng","fēng","fàng","zhǐ","yuān"]]},{"id":"2b-02","book":"2b","lesson":"2b-k1","page":2,"src":"课文","title":"咏柳","titlePy":"yǒng liǔ","author":"贺知章","authorPy":"hè zhī zhāng","dynasty":"唐","type":"诗","preface":null,"lines":["碧玉妆成一树高，","万条垂下绿丝绦。","不知细叶谁裁出，","二月春风似剪刀。"],"py":[["bì","yù","zhuāng","chéng","yī","shù","gāo"],["wàn","tiáo","chuí","xià","lǜ","sī","tāo"],["bù","zhī","xì","yè","shuí","cái","chū"],["èr","yuè","chūn","fēng","sì","jiǎn","dāo"]]},{"id":"2b-03","book":"2b","lesson":"2b-g1","page":13,"src":"园地","title":"赋得古原草送别（节选）","titlePy":"fù dé gǔ yuán cǎo sòng bié （jié xuǎn）","author":"白居易","authorPy":"bái jū yì","dynasty":"唐","type":"诗","preface":null,"lines":["离离原上草，","一岁一枯荣。","野火烧不尽，","春风吹又生。"],"py":[["lí","lí","yuán","shàng","cǎo"],["yī","suì","yī","kū","róng"],["yě","huǒ","shāo","bù","jìn"],["chūn","fēng","chuī","yòu","shēng"]]},{"id":"2b-04","book":"2b","lesson":"2b-k15","page":71,"src":"课文","title":"晓出净慈寺送林子方","titlePy":"xiǎo chū jìng cí sì sòng lín zi fāng","author":"杨万里","authorPy":"yáng wàn lǐ","dynasty":"宋","type":"诗","preface":null,"lines":["毕竟西湖六月中，","风光不与四时同。","接天莲叶无穷碧，","映日荷花别样红。"],"py":[["bì","jìng","xī","hú","liù","yuè","zhōng"],["fēng","guāng","bù","yǔ","sì","shí","tóng"],["jiē","tiān","lián","yè","wú","qióng","bì"],["yìng","rì","hé","huā","bié","yàng","hóng"]]},{"id":"2b-05","book":"2b","lesson":"2b-k15","page":72,"src":"课文","title":"绝句","titlePy":"jué jù","author":"杜甫","authorPy":"dù fǔ","dynasty":"唐","type":"诗","preface":null,"lines":["两个黄鹂鸣翠柳，","一行白鹭上青天。","窗含西岭千秋雪，","门泊东吴万里船。"],"py":[["liǎng","gè","huáng","lí","míng","cuì","liǔ"],["yī","háng","bái","lù","shàng","qīng","tiān"],["chuāng","hán","xī","lǐng","qiān","qiū","xuě"],["mén","bó","dōng","wú","wàn","lǐ","chuán"]]},{"id":"2b-06","book":"2b","lesson":"2b-g6","page":83,"src":"园地","title":"悯农（其一）","titlePy":"mǐn nóng （qí yī）","author":"李绅","authorPy":"lǐ shēn","dynasty":"唐","type":"诗","preface":null,"lines":["春种一粒粟，","秋收万颗子。","四海无闲田，","农夫犹饿死。"],"py":[["chūn","zhòng","yī","lì","sù"],["qiū","shōu","wàn","kē","zi"],["sì","hǎi","wú","xián","tián"],["nóng","fū","yóu","è","sǐ"]]},{"id":"2b-07","book":"2b","lesson":"2b-g8","page":113,"src":"园地","title":"舟夜书所见","titlePy":"zhōu yè shū suǒ jiàn","author":"查慎行","authorPy":"zhā shèn xíng","dynasty":"清","type":"诗","preface":null,"lines":["月黑见渔灯，","孤光一点萤。","微微风簇浪，","散作满河星。"],"py":[["yuè","hēi","jiàn","yú","dēng"],["gū","guāng","yì","diǎn","yíng"],["wēi","wēi","fēng","cù","làng"],["sàn","zuò","mǎn","hé","xīng"]]},{"id":"3a-01","book":"3a","lesson":"3a-g1","page":12,"src":"园地","title":"所见","titlePy":"suǒ jiàn","author":"袁枚","authorPy":"yuán méi","dynasty":"清","type":"诗","preface":null,"lines":["牧童骑黄牛，","歌声振林樾。","意欲捕鸣蝉，","忽然闭口立。"],"py":[["mù","tóng","qí","huáng","niú"],["gē","shēng","zhèn","lín","yuè"],["yì","yù","bǔ","míng","chán"],["hū","rán","bì","kǒu","lì"]]},{"id":"3a-02","book":"3a","lesson":"3a-k4","page":14,"src":"课文","title":"山行","titlePy":"shān xíng","author":"杜牧","authorPy":"dù mù","dynasty":"唐","type":"诗","preface":null,"lines":["远上寒山石径斜，","白云生处有人家。","停车坐爱枫林晚，","霜叶红于二月花。"],"py":[["yuǎn","shàng","hán","shān","shí","jìng","xié"],["bái","yún","shēng","chù","yǒu","rén","jiā"],["tíng","chē","zuò","ài","fēng","lín","wǎn"],["shuāng","yè","hóng","yú","èr","yuè","huā"]]},{"id":"3a-03","book":"3a","lesson":"3a-k4","page":14,"src":"课文","title":"赠刘景文","titlePy":"zèng liú jǐng wén","author":"苏轼","authorPy":"sū shì","dynasty":"宋","type":"诗","preface":null,"lines":["荷尽已无擎雨盖，","菊残犹有傲霜枝。","一年好景君须记，","最是橙黄橘绿时。"],"py":[["hé","jìn","yǐ","wú","qíng","yǔ","gài"],["jú","cán","yóu","yǒu","ào","shuāng","zhī"],["yī","nián","hǎo","jǐng","jūn","xū","jì"],["zuì","shì","chéng","huáng","jú","lǜ","shí"]]},{"id":"3a-04","book":"3a","lesson":"3a-k4","page":15,"src":"课文","title":"夜书所见","titlePy":"yè shū suǒ jiàn","author":"叶绍翁","authorPy":"yè shào wēng","dynasty":"宋","type":"诗","preface":null,"lines":["萧萧梧叶送寒声，","江上秋风动客情。","知有儿童挑促织，","夜深篱落一灯明。"],"py":[["xiāo","xiāo","wú","yè","sòng","hán","shēng"],["jiāng","shàng","qiū","fēng","dòng","kè","qíng"],["zhī","yǒu","ér","tóng","tiǎo","cù","zhī"],["yè","shēn","lí","luò","yī","dēng","míng"]]},{"id":"3a-05","book":"3a","lesson":"3a-k17","page":74,"src":"课文","title":"望天门山","titlePy":"wàng tiān mén shān","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["天门中断楚江开，","碧水东流至此回。","两岸青山相对出，","孤帆一片日边来。"],"py":[["tiān","mén","zhōng","duàn","chǔ","jiāng","kāi"],["bì","shuǐ","dōng","liú","zhì","cǐ","huí"],["liǎng","àn","qīng","shān","xiāng","duì","chū"],["gū","fān","yī","piàn","rì","biān","lái"]]},{"id":"3a-06","book":"3a","lesson":"3a-k17","page":74,"src":"课文","title":"饮湖上初晴后雨","titlePy":"yǐn hú shàng chū qíng hòu yǔ","author":"苏轼","authorPy":"sū shì","dynasty":"宋","type":"诗","preface":null,"lines":["水光潋滟晴方好，","山色空蒙雨亦奇。","欲把西湖比西子，","淡妆浓抹总相宜。"],"py":[["shuǐ","guāng","liàn","yàn","qíng","fāng","hǎo"],["shān","sè","kōng","méng","yǔ","yì","qí"],["yù","bǎ","xī","hú","bǐ","xī","zi"],["dàn","zhuāng","nóng","mǒ","zǒng","xiāng","yí"]]},{"id":"3a-07","book":"3a","lesson":"3a-k17","page":75,"src":"课文","title":"望洞庭","titlePy":"wàng dòng tíng","author":"刘禹锡","authorPy":"liú yǔ xī","dynasty":"唐","type":"诗","preface":null,"lines":["湖光秋月两相和，","潭面无风镜未磨。","遥望洞庭山水翠，","白银盘里一青螺。"],"py":[["hú","guāng","qiū","yuè","liǎng","xiāng","hé"],["tán","miàn","wú","fēng","jìng","wèi","mó"],["yáo","wàng","dòng","tíng","shān","shuǐ","cuì"],["bái","yín","pán","lǐ","yī","qīng","luó"]]},{"id":"3a-08","book":"3a","lesson":"3a-g6","page":86,"src":"园地","title":"早发白帝城","titlePy":"zǎo fā bái dì chéng","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["朝辞白帝彩云间，","千里江陵一日还。","两岸猿声啼不住，","轻舟已过万重山。"],"py":[["zhāo","cí","bái","dì","cǎi","yún","jiān"],["qiān","lǐ","jiāng","líng","yī","rì","huán"],["liǎng","àn","yuán","shēng","tí","bú","zhù"],["qīng","zhōu","yǐ","guò","wàn","chóng","shān"]]},{"id":"3a-09","book":"3a","lesson":"3a-g7","page":100,"src":"园地","title":"采莲曲","titlePy":"cǎi lián qǔ","author":"王昌龄","authorPy":"wáng chāng líng","dynasty":"唐","type":"诗","preface":null,"lines":["荷叶罗裙一色裁，","芙蓉向脸两边开。","乱入池中看不见，","闻歌始觉有人来。"],"py":[["hé","yè","luó","qún","yī","sè","cái"],["fú","róng","xiàng","liǎn","liǎng","biān","kāi"],["luàn","rù","chí","zhōng","kàn","bú","jiàn"],["wén","gē","shǐ","jué","yǒu","rén","lái"]]},{"id":"3b-01","book":"3b","lesson":"3b-k1","page":2,"src":"课文","title":"绝句","titlePy":"jué jù","author":"杜甫","authorPy":"dù fǔ","dynasty":"唐","type":"诗","preface":null,"lines":["迟日江山丽，","春风花草香。","泥融飞燕子，","沙暖睡鸳鸯。"],"py":[["chí","rì","jiāng","shān","lì"],["chūn","fēng","huā","cǎo","xiāng"],["ní","róng","fēi","yàn","zi"],["shā","nuǎn","shuì","yuān","yāng"]]},{"id":"3b-02","book":"3b","lesson":"3b-k1","page":2,"src":"课文","title":"惠崇春江晚景","titlePy":"huì chóng chūn jiāng wǎn jǐng","author":"苏轼","authorPy":"sū shì","dynasty":"宋","type":"诗","preface":null,"lines":["竹外桃花三两枝，","春江水暖鸭先知。","蒌蒿满地芦芽短，","正是河豚欲上时。"],"py":[["zhú","wài","táo","huā","sān","liǎng","zhī"],["chūn","jiāng","shuǐ","nuǎn","yā","xiān","zhī"],["lóu","hāo","mǎn","dì","lú","yá","duǎn"],["zhèng","shì","hé","tún","yù","shàng","shí"]]},{"id":"3b-03","book":"3b","lesson":"3b-k1","page":3,"src":"课文","title":"三衢道中","titlePy":"sān qú dào zhōng","author":"曾几","authorPy":"zēng jǐ","dynasty":"宋","type":"诗","preface":null,"lines":["梅子黄时日日晴，","小溪泛尽却山行。","绿阴不减来时路，","添得黄鹂四五声。"],"py":[["méi","zi","huáng","shí","rì","rì","qíng"],["xiǎo","xī","fàn","jìn","què","shān","xíng"],["lǜ","yīn","bù","jiǎn","lái","shí","lù"],["tiān","dé","huáng","lí","sì","wǔ","shēng"]]},{"id":"3b-04","book":"3b","lesson":"3b-g1","page":14,"src":"园地","title":"忆江南","titlePy":"yì jiāng nán","author":"白居易","authorPy":"bái jū yì","dynasty":"唐","type":"词","preface":null,"lines":["江南好，风景旧曾谙。","日出江花红胜火，春来江水绿如蓝。","能不忆江南？"],"py":[["jiāng","nán","hǎo","fēng","jǐng","jiù","céng","ān"],["rì","chū","jiāng","huā","hóng","shèng","huǒ","chūn","lái","jiāng","shuǐ","lǜ","rú","lán"],["néng","bù","yì","jiāng","nán"]]},{"id":"3b-05","book":"3b","lesson":"3b-k9","page":34,"src":"课文","title":"元日","titlePy":"yuán rì","author":"王安石","authorPy":"wáng ān shí","dynasty":"宋","type":"诗","preface":null,"lines":["爆竹声中一岁除，","春风送暖入屠苏。","千门万户曈曈日，","总把新桃换旧符。"],"py":[["bào","zhú","shēng","zhōng","yī","suì","chú"],["chūn","fēng","sòng","nuǎn","rù","tú","sū"],["qiān","mén","wàn","hù","tóng","tóng","rì"],["zǒng","bǎ","xīn","táo","huàn","jiù","fú"]]},{"id":"3b-06","book":"3b","lesson":"3b-k9","page":34,"src":"课文","title":"清明","titlePy":"qīng míng","author":"杜牧","authorPy":"dù mù","dynasty":"唐","type":"诗","preface":null,"lines":["清明时节雨纷纷，","路上行人欲断魂。","借问酒家何处有？","牧童遥指杏花村。"],"py":[["qīng","míng","shí","jié","yǔ","fēn","fēn"],["lù","shàng","xíng","rén","yù","duàn","hún"],["jiè","wèn","jiǔ","jiā","hé","chù","yǒu"],["mù","tóng","yáo","zhǐ","xìng","huā","cūn"]]},{"id":"3b-07","book":"3b","lesson":"3b-k9","page":35,"src":"课文","title":"九月九日忆山东兄弟","titlePy":"jiǔ yuè jiǔ rì yì shān dōng xiōng dì","author":"王维","authorPy":"wáng wéi","dynasty":"唐","type":"诗","preface":null,"lines":["独在异乡为异客，","每逢佳节倍思亲。","遥知兄弟登高处，","遍插茱萸少一人。"],"py":[["dú","zài","yì","xiāng","wéi","yì","kè"],["měi","féng","jiā","jié","bèi","sī","qīn"],["yáo","zhī","xiōng","dì","dēng","gāo","chù"],["biàn","chā","zhū","yú","shǎo","yī","rén"]]},{"id":"3b-08","book":"3b","lesson":"3b-g4","page":58,"src":"园地","title":"滁州西涧","titlePy":"chú zhōu xī jiàn","author":"韦应物","authorPy":"wéi yīng wù","dynasty":"唐","type":"诗","preface":null,"lines":["独怜幽草涧边生，","上有黄鹂深树鸣。","春潮带雨晚来急，","野渡无人舟自横。"],"py":[["dú","lián","yōu","cǎo","jiàn","biān","shēng"],["shàng","yǒu","huáng","lí","shēn","shù","míng"],["chūn","cháo","dài","yǔ","wǎn","lái","jí"],["yě","dù","wú","rén","zhōu","zì","héng"]]},{"id":"3b-09","book":"3b","lesson":"3b-g8","page":115,"src":"园地","title":"大林寺桃花","titlePy":"dà lín sì táo huā","author":"白居易","authorPy":"bái jū yì","dynasty":"唐","type":"诗","preface":null,"lines":["人间四月芳菲尽，","山寺桃花始盛开。","长恨春归无觅处，","不知转入此中来。"],"py":[["rén","jiān","sì","yuè","fāng","fēi","jìn"],["shān","sì","táo","huā","shǐ","shèng","kāi"],["cháng","hèn","chūn","guī","wú","mì","chù"],["bù","zhī","zhuǎn","rù","cǐ","zhōng","lái"]]},{"id":"4a-01","book":"4a","lesson":"4a-g1","page":14,"src":"园地","title":"鹿柴","titlePy":"lù zhài","author":"王维","authorPy":"wáng wéi","dynasty":"唐","type":"诗","preface":null,"lines":["空山不见人，","但闻人语响。","返景入深林，","复照青苔上。"],"py":[["kōng","shān","bú","jiàn","rén"],["dàn","wén","rén","yǔ","xiǎng"],["fǎn","yǐng","rù","shēn","lín"],["fù","zhào","qīng","tái","shàng"]]},{"id":"4a-02","book":"4a","lesson":"4a-k9","page":34,"src":"课文","title":"暮江吟","titlePy":"mù jiāng yín","author":"白居易","authorPy":"bái jū yì","dynasty":"唐","type":"诗","preface":null,"lines":["一道残阳铺水中，","半江瑟瑟半江红。","可怜九月初三夜，","露似真珠月似弓。"],"py":[["yī","dào","cán","yáng","pū","shuǐ","zhōng"],["bàn","jiāng","sè","sè","bàn","jiāng","hóng"],["kě","lián","jiǔ","yuè","chū","sān","yè"],["lù","sì","zhēn","zhū","yuè","sì","gōng"]]},{"id":"4a-03","book":"4a","lesson":"4a-k9","page":34,"src":"课文","title":"题西林壁","titlePy":"tí xī lín bì","author":"苏轼","authorPy":"sū shì","dynasty":"宋","type":"诗","preface":null,"lines":["横看成岭侧成峰，","远近高低各不同。","不识庐山真面目，","只缘身在此山中。"],"py":[["héng","kàn","chéng","lǐng","cè","chéng","fēng"],["yuǎn","jìn","gāo","dī","gè","bù","tóng"],["bù","shí","lú","shān","zhēn","miàn","mù"],["zhǐ","yuán","shēn","zài","cǐ","shān","zhōng"]]},{"id":"4a-04","book":"4a","lesson":"4a-k9","page":35,"src":"课文","title":"雪梅","titlePy":"xuě méi","author":"卢钺","authorPy":"lú yuè","dynasty":"宋","type":"诗","preface":null,"lines":["梅雪争春未肯降，","骚人阁笔费评章。","梅须逊雪三分白，","雪却输梅一段香。"],"py":[["méi","xuě","zhēng","chūn","wèi","kěn","xiáng"],["sāo","rén","gē","bǐ","fèi","píng","zhāng"],["méi","xū","xùn","xuě","sān","fēn","bái"],["xuě","què","shū","méi","yī","duàn","xiāng"]]},{"id":"4a-05","book":"4a","lesson":"4a-g4","page":58,"src":"园地","title":"嫦娥","titlePy":"cháng é","author":"李商隐","authorPy":"lǐ shāng yǐn","dynasty":"唐","type":"诗","preface":null,"lines":["云母屏风烛影深，","长河渐落晓星沉。","嫦娥应悔偷灵药，","碧海青天夜夜心。"],"py":[["yún","mǔ","píng","fēng","zhú","yǐng","shēn"],["cháng","hé","jiàn","luò","xiǎo","xīng","chén"],["cháng","é","yīng","huǐ","tōu","líng","yào"],["bì","hǎi","qīng","tiān","yè","yè","xīn"]]},{"id":"4a-06","book":"4a","lesson":"4a-k21","page":94,"src":"课文","title":"出塞","titlePy":"chū sài","author":"王昌龄","authorPy":"wáng chāng líng","dynasty":"唐","type":"诗","preface":null,"lines":["秦时明月汉时关，","万里长征人未还。","但使龙城飞将在，","不教胡马度阴山。"],"py":[["qín","shí","míng","yuè","hàn","shí","guān"],["wàn","lǐ","cháng","zhēng","rén","wèi","huán"],["dàn","shǐ","lóng","chéng","fēi","jiàng","zài"],["bù","jiào","hú","mǎ","dù","yīn","shān"]]},{"id":"4a-07","book":"4a","lesson":"4a-k21","page":94,"src":"课文","title":"凉州词","titlePy":"liáng zhōu cí","author":"王翰","authorPy":"wáng hàn","dynasty":"唐","type":"诗","preface":null,"lines":["葡萄美酒夜光杯，","欲饮琵琶马上催。","醉卧沙场君莫笑，","古来征战几人回？"],"py":[["pú","táo","měi","jiǔ","yè","guāng","bēi"],["yù","yǐn","pí","pá","mǎ","shàng","cuī"],["zuì","wò","shā","chǎng","jūn","mò","xiào"],["gǔ","lái","zhēng","zhàn","jǐ","rén","huí"]]},{"id":"4a-08","book":"4a","lesson":"4a-k21","page":95,"src":"课文","title":"夏日绝句","titlePy":"xià rì jué jù","author":"李清照","authorPy":"lǐ qīng zhào","dynasty":"宋","type":"诗","preface":null,"lines":["生当作人杰，","死亦为鬼雄。","至今思项羽，","不肯过江东。"],"py":[["shēng","dāng","zuò","rén","jié"],["sǐ","yì","wéi","guǐ","xióng"],["zhì","jīn","sī","xiàng","yǔ"],["bù","kěn","guò","jiāng","dōng"]]},{"id":"4a-09","book":"4a","lesson":"4a-g7","page":108,"src":"园地","title":"别董大","titlePy":"bié dǒng dà","author":"高适","authorPy":"gāo shì","dynasty":"唐","type":"诗","preface":null,"lines":["千里黄云白日曛，","北风吹雁雪纷纷。","莫愁前路无知己，","天下谁人不识君？"],"py":[["qiān","lǐ","huáng","yún","bái","rì","xūn"],["běi","fēng","chuī","yàn","xuě","fēn","fēn"],["mò","chóu","qián","lù","wú","zhī","jǐ"],["tiān","xià","shuí","rén","bù","shí","jūn"]]},{"id":"4b-01","book":"4b","lesson":"4b-k1","page":2,"src":"课文","title":"四时田园杂兴（其二十五）","titlePy":"sì shí tián yuán zá xìng （qí èr shí wǔ）","author":"范成大","authorPy":"fàn chéng dà","dynasty":"宋","type":"诗","preface":null,"lines":["梅子金黄杏子肥，","麦花雪白菜花稀。","日长篱落无人过，","惟有蜻蜓蛱蝶飞。"],"py":[["méi","zi","jīn","huáng","xìng","zi","féi"],["mài","huā","xuě","bái","cài","huā","xī"],["rì","cháng","lí","luò","wú","rén","guò"],["wéi","yǒu","qīng","tíng","jiá","dié","fēi"]]},{"id":"4b-02","book":"4b","lesson":"4b-k1","page":2,"src":"课文","title":"宿新市徐公店","titlePy":"sù xīn shì xú gōng diàn","author":"杨万里","authorPy":"yáng wàn lǐ","dynasty":"宋","type":"诗","preface":null,"lines":["篱落疏疏一径深，","树头新绿未成阴。","儿童急走追黄蝶，","飞入菜花无处寻。"],"py":[["lí","luò","shū","shū","yī","jìng","shēn"],["shù","tóu","xīn","lǜ","wèi","chéng","yīn"],["ér","tóng","jí","zǒu","zhuī","huáng","dié"],["fēi","rù","cài","huā","wú","chù","xún"]]},{"id":"4b-03","book":"4b","lesson":"4b-k1","page":3,"src":"课文","title":"清平乐·村居","titlePy":"qīng píng yuè · cūn jū","author":"辛弃疾","authorPy":"xīn qì jí","dynasty":"宋","type":"词","preface":null,"lines":["茅檐低小，溪上青青草。","醉里吴音相媚好，白发谁家翁媪？","大儿锄豆溪东，中儿正织鸡笼。","最喜小儿亡赖，溪头卧剥莲蓬。"],"py":[["máo","yán","dī","xiǎo","xī","shàng","qīng","qīng","cǎo"],["zuì","lǐ","wú","yīn","xiāng","mèi","hǎo","bái","fà","shuí","jiā","wēng","ǎo"],["dà","ér","chú","dòu","xī","dōng","zhōng","ér","zhèng","zhī","jī","lóng"],["zuì","xǐ","xiǎo","ér","wú","lài","xī","tóu","wò","bāo","lián","péng"]]},{"id":"4b-04","book":"4b","lesson":"4b-g1","page":14,"src":"园地","title":"卜算子·咏梅","titlePy":"bǔ suàn zǐ · yǒng méi","author":"毛泽东","authorPy":"máo zé dōng","dynasty":"现代","type":"词","preface":null,"lines":["风雨送春归，","飞雪迎春到。","已是悬崖百丈冰，","犹有花枝俏。","俏也不争春，","只把春来报。","待到山花烂漫时，","她在丛中笑。"],"py":[["fēng","yǔ","sòng","chūn","guī"],["fēi","xuě","yíng","chūn","dào"],["yǐ","shì","xuán","yá","bǎi","zhàng","bīng"],["yóu","yǒu","huā","zhī","qiào"],["qiào","yě","bù","zhēng","chūn"],["zhǐ","bǎ","chūn","lái","bào"],["dài","dào","shān","huā","làn","màn","shí"],["tā","zài","cóng","zhōng","xiào"]]},{"id":"4b-05","book":"4b","lesson":"4b-g2","page":32,"src":"园地","title":"江畔独步寻花","titlePy":"jiāng pàn dú bù xún huā","author":"杜甫","authorPy":"dù fǔ","dynasty":"唐","type":"诗","preface":null,"lines":["黄师塔前江水东，","春光懒困倚微风。","桃花一簇开无主，","可爱深红爱浅红？"],"py":[["huáng","shī","tǎ","qián","jiāng","shuǐ","dōng"],["chūn","guāng","lǎn","kùn","yǐ","wēi","fēng"],["táo","huā","yī","cù","kāi","wú","zhǔ"],["kě","ài","shēn","hóng","ài","qiǎn","hóng"]]},{"id":"4b-06","book":"4b","lesson":"4b-g4","page":62,"src":"园地","title":"蜂","titlePy":"fēng","author":"罗隐","authorPy":"luó yǐn","dynasty":"唐","type":"诗","preface":null,"lines":["不论平地与山尖，","无限风光尽被占。","采得百花成蜜后，","为谁辛苦为谁甜？"],"py":[["bù","lùn","píng","dì","yǔ","shān","jiān"],["wú","xiàn","fēng","guāng","jìn","bèi","zhàn"],["cǎi","dé","bǎi","huā","chéng","mì","hòu"],["wèi","shuí","xīn","kǔ","wèi","shuí","tián"]]},{"id":"4b-07","book":"4b","lesson":"4b-g6","page":100,"src":"园地","title":"独坐敬亭山","titlePy":"dú zuò jìng tíng shān","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["众鸟高飞尽，","孤云独去闲。","相看两不厌，","只有敬亭山。"],"py":[["zhòng","niǎo","gāo","fēi","jìn"],["gū","yún","dú","qù","xián"],["xiāng","kàn","liǎng","bù","yàn"],["zhǐ","yǒu","jìng","tíng","shān"]]},{"id":"4b-08","book":"4b","lesson":"4b-k22","page":102,"src":"课文","title":"芙蓉楼送辛渐","titlePy":"fú róng lóu sòng xīn jiàn","author":"王昌龄","authorPy":"wáng chāng líng","dynasty":"唐","type":"诗","preface":null,"lines":["寒雨连江夜入吴，","平明送客楚山孤。","洛阳亲友如相问，","一片冰心在玉壶。"],"py":[["hán","yǔ","lián","jiāng","yè","rù","wú"],["píng","míng","sòng","kè","chǔ","shān","gū"],["luò","yáng","qīn","yǒu","rú","xiāng","wèn"],["yī","piàn","bīng","xīn","zài","yù","hú"]]},{"id":"4b-09","book":"4b","lesson":"4b-k22","page":102,"src":"课文","title":"塞下曲","titlePy":"sài xià qǔ","author":"卢纶","authorPy":"lú lún","dynasty":"唐","type":"诗","preface":null,"lines":["月黑雁飞高，","单于夜遁逃。","欲将轻骑逐，","大雪满弓刀。"],"py":[["yuè","hēi","yàn","fēi","gāo"],["chán","yú","yè","dùn","táo"],["yù","jiāng","qīng","qí","zhú"],["dà","xuě","mǎn","gōng","dāo"]]},{"id":"4b-10","book":"4b","lesson":"4b-k22","page":103,"src":"课文","title":"墨梅","titlePy":"mò méi","author":"王冕","authorPy":"wáng miǎn","dynasty":"元","type":"诗","preface":null,"lines":["我家洗砚池头树，","朵朵花开淡墨痕。","不要人夸好颜色，","只留清气满乾坤。"],"py":[["wǒ","jiā","xǐ","yàn","chí","tóu","shù"],["duǒ","duǒ","huā","kāi","dàn","mò","hén"],["bú","yào","rén","kuā","hǎo","yán","sè"],["zhǐ","liú","qīng","qì","mǎn","qián","kūn"]]},{"id":"5a-01","book":"5a","lesson":"5a-g1","page":14,"src":"园地","title":"蝉","titlePy":"chán","author":"虞世南","authorPy":"yú shì nán","dynasty":"唐","type":"诗","preface":null,"lines":["垂緌饮清露，","流响出疏桐。","居高声自远，","非是藉秋风。"],"py":[["chuí","ruí","yǐn","qīng","lù"],["liú","xiǎng","chū","shū","tóng"],["jū","gāo","shēng","zì","yuǎn"],["fēi","shì","jí","qiū","fēng"]]},{"id":"5a-02","book":"5a","lesson":"5a-g3","page":46,"src":"园地","title":"乞巧","titlePy":"qǐ qiǎo","author":"林杰","authorPy":"lín jié","dynasty":"唐","type":"诗","preface":null,"lines":["七夕今宵看碧霄，","牵牛织女渡河桥。","家家乞巧望秋月，","穿尽红丝几万条。"],"py":[["qī","xī","jīn","xiāo","kàn","bì","xiāo"],["qiān","niú","zhī","nǚ","dù","hé","qiáo"],["jiā","jiā","qǐ","qiǎo","wàng","qiū","yuè"],["chuān","jìn","hóng","sī","jǐ","wàn","tiáo"]]},{"id":"5a-03","book":"5a","lesson":"5a-k12","page":50,"src":"课文","title":"示儿","titlePy":"shì ér","author":"陆游","authorPy":"lù yóu","dynasty":"宋","type":"诗","preface":null,"lines":["死去元知万事空，","但悲不见九州同。","王师北定中原日，","家祭无忘告乃翁。"],"py":[["sǐ","qù","yuán","zhī","wàn","shì","kōng"],["dàn","bēi","bú","jiàn","jiǔ","zhōu","tóng"],["wáng","shī","běi","dìng","zhōng","yuán","rì"],["jiā","jì","wú","wàng","gào","nǎi","wēng"]]},{"id":"5a-04","book":"5a","lesson":"5a-k12","page":50,"src":"课文","title":"题临安邸","titlePy":"tí lín ān dǐ","author":"林升","authorPy":"lín shēng","dynasty":"宋","type":"诗","preface":null,"lines":["山外青山楼外楼，","西湖歌舞几时休？","暖风熏得游人醉，","直把杭州作汴州。"],"py":[["shān","wài","qīng","shān","lóu","wài","lóu"],["xī","hú","gē","wǔ","jǐ","shí","xiū"],["nuǎn","fēng","xūn","dé","yóu","rén","zuì"],["zhí","bǎ","háng","zhōu","zuò","biàn","zhōu"]]},{"id":"5a-05","book":"5a","lesson":"5a-k12","page":51,"src":"课文","title":"己亥杂诗","titlePy":"jǐ hài zá shī","author":"龚自珍","authorPy":"gōng zì zhēn","dynasty":"清","type":"诗","preface":null,"lines":["九州生气恃风雷，","万马齐喑究可哀。","我劝天公重抖擞，","不拘一格降人材。"],"py":[["jiǔ","zhōu","shēng","qì","shì","fēng","léi"],["wàn","mǎ","qí","yīn","jiū","kě","āi"],["wǒ","quàn","tiān","gōng","chóng","dǒu","sǒu"],["bù","jū","yī","gé","jiàng","rén","cái"]]},{"id":"5a-06","book":"5a","lesson":"5a-k21","page":92,"src":"课文","title":"山居秋暝","titlePy":"shān jū qiū míng","author":"王维","authorPy":"wáng wéi","dynasty":"唐","type":"诗","preface":null,"lines":["空山新雨后，天气晚来秋。","明月松间照，清泉石上流。","竹喧归浣女，莲动下渔舟。","随意春芳歇，王孙自可留。"],"py":[["kōng","shān","xīn","yǔ","hòu","tiān","qì","wǎn","lái","qiū"],["míng","yuè","sōng","jiān","zhào","qīng","quán","shí","shàng","liú"],["zhú","xuān","guī","huàn","nǚ","lián","dòng","xià","yú","zhōu"],["suí","yì","chūn","fāng","xiē","wáng","sūn","zì","kě","liú"]]},{"id":"5a-07","book":"5a","lesson":"5a-k21","page":92,"src":"课文","title":"枫桥夜泊","titlePy":"fēng qiáo yè bó","author":"张继","authorPy":"zhāng jì","dynasty":"唐","type":"诗","preface":null,"lines":["月落乌啼霜满天，","江枫渔火对愁眠。","姑苏城外寒山寺，","夜半钟声到客船。"],"py":[["yuè","luò","wū","tí","shuāng","mǎn","tiān"],["jiāng","fēng","yú","huǒ","duì","chóu","mián"],["gū","sū","chéng","wài","hán","shān","sì"],["yè","bàn","zhōng","shēng","dào","kè","chuán"]]},{"id":"5a-08","book":"5a","lesson":"5a-k21","page":93,"src":"课文","title":"长相思","titlePy":"cháng xiāng sī","author":"纳兰性德","authorPy":"nà lán xìng dé","dynasty":"清","type":"词","preface":null,"lines":["山一程，水一程，身向榆关那畔行，夜深千帐灯。","风一更，雪一更，聒碎乡心梦不成，故园无此声。"],"py":[["shān","yī","chéng","shuǐ","yī","chéng","shēn","xiàng","yú","guān","nà","pàn","xíng","yè","shēn","qiān","zhàng","dēng"],["fēng","yī","gēng","xuě","yī","gēng","guō","suì","xiāng","xīn","mèng","bù","chéng","gù","yuán","wú","cǐ","shēng"]]},{"id":"5a-09","book":"5a","lesson":"5a-g7","page":104,"src":"园地","title":"渔歌子","titlePy":"yú gē zǐ","author":"张志和","authorPy":"zhāng zhì hé","dynasty":"唐","type":"词","preface":null,"lines":["西塞山前白鹭飞，桃花流水鳜鱼肥。","青箬笠，绿蓑衣，斜风细雨不须归。"],"py":[["xī","sài","shān","qián","bái","lù","fēi","táo","huā","liú","shuǐ","guì","yú","féi"],["qīng","ruò","lì","lǜ","suō","yī","xié","fēng","xì","yǔ","bù","xū","guī"]]},{"id":"5a-10","book":"5a","lesson":"5a-g8","page":118,"src":"园地","title":"观书有感（其一）","titlePy":"guān shū yǒu gǎn （qí yī）","author":"朱熹","authorPy":"zhū xī","dynasty":"宋","type":"诗","preface":null,"lines":["半亩方塘一鉴开，","天光云影共徘徊。","问渠那得清如许？","为有源头活水来。"],"py":[["bàn","mǔ","fāng","táng","yī","jiàn","kāi"],["tiān","guāng","yún","yǐng","gòng","pái","huái"],["wèn","qú","nǎ","dé","qīng","rú","xǔ"],["wèi","yǒu","yuán","tóu","huó","shuǐ","lái"]]},{"id":"5a-11","book":"5a","lesson":"5a-g8","page":118,"src":"园地","title":"观书有感（其二）","titlePy":"guān shū yǒu gǎn （qí èr）","author":"朱熹","authorPy":"zhū xī","dynasty":"宋","type":"诗","preface":null,"lines":["昨夜江边春水生，","蒙冲巨舰一毛轻。","向来枉费推移力，","此日中流自在行。"],"py":[["zuó","yè","jiāng","biān","chūn","shuǐ","shēng"],["méng","chōng","jù","jiàn","yī","máo","qīng"],["xiàng","lái","wǎng","fèi","tuī","yí","lì"],["cǐ","rì","zhōng","liú","zì","zài","xíng"]]},{"id":"5b-01","book":"5b","lesson":"5b-k1","page":2,"src":"课文","title":"四时田园杂兴（其三十一）","titlePy":"sì shí tián yuán zá xìng （qí sān shí yī）","author":"范成大","authorPy":"fàn chéng dà","dynasty":"宋","type":"诗","preface":null,"lines":["昼出耘田夜绩麻，","村庄儿女各当家。","童孙未解供耕织，","也傍桑阴学种瓜。"],"py":[["zhòu","chū","yún","tián","yè","jì","má"],["cūn","zhuāng","ér","nǚ","gè","dāng","jiā"],["tóng","sūn","wèi","jiě","gòng","gēng","zhī"],["yě","bàng","sāng","yīn","xué","zhòng","guā"]]},{"id":"5b-02","book":"5b","lesson":"5b-k1","page":2,"src":"课文","title":"稚子弄冰","titlePy":"zhì zi nòng bīng","author":"杨万里","authorPy":"yáng wàn lǐ","dynasty":"宋","type":"诗","preface":null,"lines":["稚子金盆脱晓冰，","彩丝穿取当银钲。","敲成玉磬穿林响，","忽作玻璃碎地声。"],"py":[["zhì","zi","jīn","pén","tuō","xiǎo","bīng"],["cǎi","sī","chuān","qǔ","dàng","yín","zhēng"],["qiāo","chéng","yù","qìng","chuān","lín","xiǎng"],["hū","zuò","bō","lí","suì","dì","shēng"]]},{"id":"5b-03","book":"5b","lesson":"5b-k1","page":3,"src":"课文","title":"村晚","titlePy":"cūn wǎn","author":"雷震","authorPy":"léi zhèn","dynasty":"宋","type":"诗","preface":null,"lines":["草满池塘水满陂，","山衔落日浸寒漪。","牧童归去横牛背，","短笛无腔信口吹。"],"py":[["cǎo","mǎn","chí","táng","shuǐ","mǎn","bēi"],["shān","xián","luò","rì","jìn","hán","yī"],["mù","tóng","guī","qù","héng","niú","bèi"],["duǎn","dí","wú","qiāng","xìn","kǒu","chuī"]]},{"id":"5b-04","book":"5b","lesson":"5b-g1","page":16,"src":"园地","title":"游子吟","titlePy":"yóu zǐ yín","author":"孟郊","authorPy":"mèng jiāo","dynasty":"唐","type":"诗","preface":null,"lines":["慈母手中线，","游子身上衣。","临行密密缝，","意恐迟迟归。","谁言寸草心，","报得三春晖。"],"py":[["cí","mǔ","shǒu","zhōng","xiàn"],["yóu","zi","shēn","shàng","yī"],["lín","xíng","mì","mì","féng"],["yì","kǒng","chí","chí","guī"],["shuí","yán","cùn","cǎo","xīn"],["bào","dé","sān","chūn","huī"]]},{"id":"5b-05","book":"5b","lesson":"5b-g2","page":38,"src":"园地","title":"鸟鸣涧","titlePy":"niǎo míng jiàn","author":"王维","authorPy":"wáng wéi","dynasty":"唐","type":"诗","preface":null,"lines":["人闲桂花落，","夜静春山空。","月出惊山鸟，","时鸣春涧中。"],"py":[["rén","xián","guì","huā","luò"],["yè","jìng","chūn","shān","kōng"],["yuè","chū","jīng","shān","niǎo"],["shí","míng","chūn","jiàn","zhōng"]]},{"id":"5b-06","book":"5b","lesson":"5b-k9","page":54,"src":"课文","title":"从军行","titlePy":"cóng jūn xíng","author":"王昌龄","authorPy":"wáng chāng líng","dynasty":"唐","type":"诗","preface":null,"lines":["青海长云暗雪山，","孤城遥望玉门关。","黄沙百战穿金甲，","不破楼兰终不还。"],"py":[["qīng","hǎi","cháng","yún","àn","xuě","shān"],["gū","chéng","yáo","wàng","yù","mén","guān"],["huáng","shā","bǎi","zhàn","chuān","jīn","jiǎ"],["bù","pò","lóu","lán","zhōng","bù","huán"]]},{"id":"5b-07","book":"5b","lesson":"5b-k9","page":54,"src":"课文","title":"秋夜将晓出篱门迎凉有感","titlePy":"qiū yè jiāng xiǎo chū lí mén yíng liáng yǒu gǎn","author":"陆游","authorPy":"lù yóu","dynasty":"宋","type":"诗","preface":null,"lines":["三万里河东入海，","五千仞岳上摩天。","遗民泪尽胡尘里，","南望王师又一年。"],"py":[["sān","wàn","lǐ","hé","dōng","rù","hǎi"],["wǔ","qiān","rèn","yuè","shàng","mó","tiān"],["yí","mín","lèi","jìn","hú","chén","lǐ"],["nán","wàng","wáng","shī","yòu","yī","nián"]]},{"id":"5b-08","book":"5b","lesson":"5b-k9","page":55,"src":"课文","title":"闻官军收河南河北","titlePy":"wén guān jūn shōu hé nán hé běi","author":"杜甫","authorPy":"dù fǔ","dynasty":"唐","type":"诗","preface":null,"lines":["剑外忽传收蓟北，","初闻涕泪满衣裳。","却看妻子愁何在，","漫卷诗书喜欲狂。","白日放歌须纵酒，","青春作伴好还乡。","即从巴峡穿巫峡，","便下襄阳向洛阳。"],"py":[["jiàn","wài","hū","chuán","shōu","jì","běi"],["chū","wén","tì","lèi","mǎn","yī","cháng"],["què","kàn","qī","zǐ","chóu","hé","zài"],["màn","juǎn","shī","shū","xǐ","yù","kuáng"],["bái","rì","fàng","gē","xū","zòng","jiǔ"],["qīng","chūn","zuò","bàn","hǎo","huán","xiāng"],["jí","cóng","bā","xiá","chuān","wū","xiá"],["biàn","xià","xiāng","yáng","xiàng","luò","yáng"]]},{"id":"5b-09","book":"5b","lesson":"5b-g4","page":68,"src":"园地","title":"黄鹤楼送孟浩然之广陵","titlePy":"huáng hè lóu sòng mèng hào rán zhī guǎng líng","author":"李白","authorPy":"lǐ bái","dynasty":"唐","type":"诗","preface":null,"lines":["故人西辞黄鹤楼，","烟花三月下扬州。","孤帆远影碧空尽，","唯见长江天际流。"],"py":[["gù","rén","xī","cí","huáng","hè","lóu"],["yān","huā","sān","yuè","xià","yáng","zhōu"],["gū","fān","yuǎn","yǐng","bì","kōng","jìn"],["wéi","jiàn","cháng","jiāng","tiān","jì","liú"]]},{"id":"5b-10","book":"5b","lesson":"5b-g4","page":68,"src":"园地","title":"凉州词","titlePy":"liáng zhōu cí","author":"王之涣","authorPy":"wáng zhī huàn","dynasty":"唐","type":"诗","preface":null,"lines":["黄河远上白云间，","一片孤城万仞山。","羌笛何须怨杨柳，","春风不度玉门关。"],"py":[["huáng","hé","yuǎn","shàng","bái","yún","jiān"],["yī","piàn","gū","chéng","wàn","rèn","shān"],["qiāng","dí","hé","xū","yuàn","yáng","liǔ"],["chūn","fēng","bù","dù","yù","mén","guān"]]},{"id":"5b-11","book":"5b","lesson":"5b-g7","page":106,"src":"园地","title":"乡村四月","titlePy":"xiāng cūn sì yuè","author":"翁卷","authorPy":"wēng juǎn","dynasty":"宋","type":"诗","preface":null,"lines":["绿遍山原白满川，","子规声里雨如烟。","乡村四月闲人少，","才了蚕桑又插田。"],"py":[["lǜ","biàn","shān","yuán","bái","mǎn","chuān"],["zi","guī","shēng","lǐ","yǔ","rú","yān"],["xiāng","cūn","sì","yuè","xián","rén","shǎo"],["cái","liǎo","cán","sāng","yòu","chā","tián"]]},{"id":"6a-01","book":"6a","lesson":"6a-k5","page":16,"src":"课文","title":"七律·长征","titlePy":"qī lǜ · cháng zhēng","author":"毛泽东","authorPy":"máo zé dōng","dynasty":"现代","type":"诗","preface":null,"lines":["红军不怕远征难，","万水千山只等闲。","五岭逶迤腾细浪，","乌蒙磅礴走泥丸。","金沙水拍云崖暖，","大渡桥横铁索寒。","更喜岷山千里雪，","三军过后尽开颜。"],"py":[["hóng","jūn","bù","pà","yuǎn","zhēng","nán"],["wàn","shuǐ","qiān","shān","zhǐ","děng","xián"],["wǔ","lǐng","wēi","yí","téng","xì","làng"],["wū","méng","páng","bó","zǒu","ní","wán"],["jīn","shā","shuǐ","pāi","yún","yá","nuǎn"],["dà","dù","qiáo","héng","tiě","suǒ","hán"],["gèng","xǐ","mín","shān","qiān","lǐ","xuě"],["sān","jūn","guò","hòu","jìn","kāi","yán"]]},{"id":"6a-02","book":"6a","lesson":"6a-k3","page":8,"src":"课文","title":"宿建德江","titlePy":"sù jiàn dé jiāng","author":"孟浩然","authorPy":"mèng hào rán","dynasty":"唐","type":"诗","preface":null,"lines":["移舟泊烟渚，","日暮客愁新。","野旷天低树，","江清月近人。"],"py":[["yí","zhōu","bó","yān","zhǔ"],["rì","mù","kè","chóu","xīn"],["yě","kuàng","tiān","dī","shù"],["jiāng","qīng","yuè","jìn","rén"]]},{"id":"6a-03","book":"6a","lesson":"6a-k3","page":8,"src":"课文","title":"六月二十七日望湖楼醉书","titlePy":"liù yuè èr shí qī rì wàng hú lóu zuì shū","author":"苏轼","authorPy":"sū shì","dynasty":"宋","type":"诗","preface":null,"lines":["黑云翻墨未遮山，","白雨跳珠乱入船。","卷地风来忽吹散，","望湖楼下水如天。"],"py":[["hēi","yún","fān","mò","wèi","zhē","shān"],["bái","yǔ","tiào","zhū","luàn","rù","chuán"],["juǎn","dì","fēng","lái","hū","chuī","sàn"],["wàng","hú","lóu","xià","shuǐ","rú","tiān"]]},{"id":"6a-04","book":"6a","lesson":"6a-k3","page":9,"src":"课文","title":"西江月·夜行黄沙道中","titlePy":"xī jiāng yuè · yè xíng huáng shā dào zhōng","author":"辛弃疾","authorPy":"xīn qì jí","dynasty":"宋","type":"词","preface":null,"lines":["明月别枝惊鹊，清风半夜鸣蝉。","稻花香里说丰年，听取蛙声一片。","七八个星天外，两三点雨山前。","旧时茅店社林边，路转溪桥忽见。"],"py":[["míng","yuè","bié","zhī","jīng","què","qīng","fēng","bàn","yè","míng","chán"],["dào","huā","xiāng","lǐ","shuō","fēng","nián","tīng","qǔ","wā","shēng","yī","piàn"],["qī","bā","gè","xīng","tiān","wài","liǎng","sān","diǎn","yǔ","shān","qián"],["jiù","shí","máo","diàn","shè","lín","biān","lù","zhuǎn","xī","qiáo","hū","xiàn"]]},{"id":"6a-05","book":"6a","lesson":"6a-g1","page":14,"src":"园地","title":"过故人庄","titlePy":"guò gù rén zhuāng","author":"孟浩然","authorPy":"mèng hào rán","dynasty":"唐","type":"诗","preface":null,"lines":["故人具鸡黍，邀我至田家。","绿树村边合，青山郭外斜。","开轩面场圃，把酒话桑麻。","待到重阳日，还来就菊花。"],"py":[["gù","rén","jù","jī","shǔ","yāo","wǒ","zhì","tián","jiā"],["lǜ","shù","cūn","biān","hé","qīng","shān","guō","wài","xié"],["kāi","xuān","miàn","chǎng","pǔ","bǎ","jiǔ","huà","sāng","má"],["dài","dào","chóng","yáng","rì","hái","lái","jiù","jú","huā"]]},{"id":"6a-06","book":"6a","lesson":"6a-g3","page":52,"src":"园地","title":"春日","titlePy":"chūn rì","author":"朱熹","authorPy":"zhū xī","dynasty":"宋","type":"诗","preface":null,"lines":["胜日寻芳泗水滨，","无边光景一时新。","等闲识得东风面，","万紫千红总是春。"],"py":[["shèng","rì","xún","fāng","sì","shuǐ","bīn"],["wú","biān","guāng","jǐng","yī","shí","xīn"],["děng","xián","shí","dé","dōng","fēng","miàn"],["wàn","zǐ","qiān","hóng","zǒng","shì","chūn"]]},{"id":"6a-07","book":"6a","lesson":"6a-g4","page":70,"src":"园地","title":"回乡偶书","titlePy":"huí xiāng ǒu shū","author":"贺知章","authorPy":"hè zhī zhāng","dynasty":"唐","type":"诗","preface":null,"lines":["少小离家老大回，","乡音无改鬓毛衰。","儿童相见不相识，","笑问客从何处来。"],"py":[["shào","xiǎo","lí","jiā","lǎo","dà","huí"],["xiāng","yīn","wú","gǎi","bìn","máo","shuāi"],["ér","tóng","xiāng","jiàn","bù","xiāng","shí"],["xiào","wèn","kè","cóng","hé","chù","lái"]]},{"id":"6a-08","book":"6a","lesson":"6a-k18","page":86,"src":"课文","title":"浪淘沙（其一）","titlePy":"làng táo shā （qí yī）","author":"刘禹锡","authorPy":"liú yǔ xī","dynasty":"唐","type":"诗","preface":null,"lines":["九曲黄河万里沙，","浪淘风簸自天涯。","如今直上银河去，","同到牵牛织女家。"],"py":[["jiǔ","qū","huáng","hé","wàn","lǐ","shā"],["làng","táo","fēng","bǒ","zì","tiān","yá"],["rú","jīn","zhí","shàng","yín","hé","qù"],["tóng","dào","qiān","niú","zhī","nǚ","jiā"]]},{"id":"6a-09","book":"6a","lesson":"6a-k18","page":86,"src":"课文","title":"江南春","titlePy":"jiāng nán chūn","author":"杜牧","authorPy":"dù mù","dynasty":"唐","type":"诗","preface":null,"lines":["千里莺啼绿映红，","水村山郭酒旗风。","南朝四百八十寺，","多少楼台烟雨中。"],"py":[["qiān","lǐ","yīng","tí","lǜ","yìng","hóng"],["shuǐ","cūn","shān","guō","jiǔ","qí","fēng"],["nán","cháo","sì","bǎi","bā","shí","sì"],["duō","shǎo","lóu","tái","yān","yǔ","zhōng"]]},{"id":"6a-10","book":"6a","lesson":"6a-k18","page":87,"src":"课文","title":"书湖阴先生壁","titlePy":"shū hú yīn xiān shēng bì","author":"王安石","authorPy":"wáng ān shí","dynasty":"宋","type":"诗","preface":null,"lines":["茅檐长扫净无苔，","花木成畦手自栽。","一水护田将绿绕，","两山排闼送青来。"],"py":[["máo","yán","cháng","sǎo","jìng","wú","tái"],["huā","mù","chéng","qí","shǒu","zì","zāi"],["yī","shuǐ","hù","tián","jiāng","lǜ","rào"],["liǎng","shān","pái","tà","sòng","qīng","lái"]]},{"id":"6b-01","book":"6b","lesson":"6b-k3","page":11,"src":"课文","title":"寒食","titlePy":"hán shí","author":"韩翃","authorPy":"hán hóng","dynasty":"唐","type":"诗","preface":null,"lines":["春城无处不飞花，","寒食东风御柳斜。","日暮汉宫传蜡烛，","轻烟散入五侯家。"],"py":[["chūn","chéng","wú","chù","bù","fēi","huā"],["hán","shí","dōng","fēng","yù","liǔ","xié"],["rì","mù","hàn","gōng","chuán","là","zhú"],["qīng","yān","sàn","rù","wǔ","hóu","jiā"]]},{"id":"6b-02","book":"6b","lesson":"6b-k3","page":11,"src":"课文","title":"迢迢牵牛星","titlePy":"tiáo tiáo qiān niú xīng","author":"《古诗十九首》","authorPy":"","dynasty":"汉","type":"诗","preface":null,"lines":["迢迢牵牛星，皎皎河汉女。","纤纤擢素手，札札弄机杼。","终日不成章，泣涕零如雨。","河汉清且浅，相去复几许。","盈盈一水间，脉脉不得语。"],"py":[["tiáo","tiáo","qiān","niú","xīng","jiǎo","jiǎo","hé","hàn","nǚ"],["xiān","xiān","zhuó","sù","shǒu","zhá","zhá","nòng","jī","zhù"],["zhōng","rì","bù","chéng","zhāng","qì","tì","líng","rú","yǔ"],["hé","hàn","qīng","qiě","qiǎn","xiāng","qù","fù","jǐ","xǔ"],["yíng","yíng","yī","shuǐ","jiān","mò","mò","bù","dé","yǔ"]]},{"id":"6b-03","book":"6b","lesson":"6b-k3","page":12,"src":"课文","title":"十五夜望月","titlePy":"shí wǔ yè wàng yuè","author":"王建","authorPy":"wáng jiàn","dynasty":"唐","type":"诗","preface":null,"lines":["中庭地白树栖鸦，","冷露无声湿桂花。","今夜月明人尽望，","不知秋思落谁家。"],"py":[["zhōng","tíng","dì","bái","shù","qī","yā"],["lěng","lù","wú","shēng","shī","guì","huā"],["jīn","yè","yuè","míng","rén","jìn","wàng"],["bù","zhī","qiū","sī","luò","shuí","jiā"]]},{"id":"6b-04","book":"6b","lesson":"6b-g1","page":18,"src":"园地","title":"长歌行","titlePy":"cháng gē xíng","author":"汉乐府","authorPy":"hàn yuè fǔ","dynasty":"汉","type":"诗","preface":null,"lines":["青青园中葵，朝露待日晞。","阳春布德泽，万物生光辉。","常恐秋节至，焜黄华叶衰。","百川东到海，何时复西归？","少壮不努力，老大徒伤悲！"],"py":[["qīng","qīng","yuán","zhōng","kuí","zhāo","lù","dài","rì","xī"],["yáng","chūn","bù","dé","zé","wàn","wù","shēng","guāng","huī"],["cháng","kǒng","qiū","jié","zhì","kūn","huáng","huā","yè","shuāi"],["bǎi","chuān","dōng","dào","hǎi","hé","shí","fù","xī","guī"],["shào","zhuàng","bù","nǔ","lì","lǎo","dà","tú","shāng","bēi"]]},{"id":"6b-05","book":"6b","lesson":"6b-k10","page":58,"src":"课文","title":"马诗","titlePy":"mǎ shī","author":"李贺","authorPy":"lǐ hè","dynasty":"唐","type":"诗","preface":null,"lines":["大漠沙如雪，","燕山月似钩。","何当金络脑，","快走踏清秋。"],"py":[["dà","mò","shā","rú","xuě"],["yān","shān","yuè","sì","gōu"],["hé","dāng","jīn","luò","nǎo"],["kuài","zǒu","tà","qīng","qiū"]]},{"id":"6b-06","book":"6b","lesson":"6b-k10","page":58,"src":"课文","title":"石灰吟","titlePy":"shí huī yín","author":"于谦","authorPy":"yú qiān","dynasty":"明","type":"诗","preface":null,"lines":["千锤万凿出深山，","烈火焚烧若等闲。","粉骨碎身浑不怕，","要留清白在人间。"],"py":[["qiān","chuí","wàn","záo","chū","shēn","shān"],["liè","huǒ","fén","shāo","ruò","děng","xián"],["fěn","gǔ","suì","shēn","hún","bù","pà"],["yào","liú","qīng","bái","zài","rén","jiān"]]},{"id":"6b-07","book":"6b","lesson":"6b-k10","page":59,"src":"课文","title":"竹石","titlePy":"zhú shí","author":"郑燮","authorPy":"zhèng xiè","dynasty":"清","type":"诗","preface":null,"lines":["咬定青山不放松，","立根原在破岩中。","千磨万击还坚劲，","任尔东西南北风。"],"py":[["yǎo","dìng","qīng","shān","bù","fàng","sōng"],["lì","gēn","yuán","zài","pò","yán","zhōng"],["qiān","mó","wàn","jī","hái","jiān","jìng"],["rèn","ěr","dōng","xī","nán","běi","fēng"]]},{"id":"6b-08","book":"6b","lesson":"6b-r","page":111,"src":"诵读","title":"采薇（节选）","titlePy":"cǎi wēi （jié xuǎn）","author":"《诗经·小雅》","authorPy":"","dynasty":"先秦","type":"诗","preface":null,"lines":["昔我往矣，","杨柳依依。","今我来思，","雨雪霏霏。","行道迟迟，","载渴载饥。","我心伤悲，","莫知我哀！"],"py":[["xī","wǒ","wǎng","yǐ"],["yáng","liǔ","yī","yī"],["jīn","wǒ","lái","sī"],["yù","xuě","fēi","fēi"],["xíng","dào","chí","chí"],["zài","kě","zài","jī"],["wǒ","xīn","shāng","bēi"],["mò","zhī","wǒ","āi"]]},{"id":"6b-09","book":"6b","lesson":"6b-r","page":112,"src":"诵读","title":"送元二使安西","titlePy":"sòng yuán èr shǐ ān xī","author":"王维","authorPy":"wáng wéi","dynasty":"唐","type":"诗","preface":null,"lines":["渭城朝雨浥轻尘，","客舍青青柳色新。","劝君更尽一杯酒，","西出阳关无故人。"],"py":[["wèi","chéng","zhāo","yǔ","yì","qīng","chén"],["kè","shè","qīng","qīng","liǔ","sè","xīn"],["quàn","jūn","gèng","jìn","yī","bēi","jiǔ"],["xī","chū","yáng","guān","wú","gù","rén"]]},{"id":"6b-10","book":"6b","lesson":"6b-r","page":113,"src":"诵读","title":"春夜喜雨","titlePy":"chūn yè xǐ yǔ","author":"杜甫","authorPy":"dù fǔ","dynasty":"唐","type":"诗","preface":null,"lines":["好雨知时节，当春乃发生。","随风潜入夜，润物细无声。","野径云俱黑，江船火独明。","晓看红湿处，花重锦官城。"],"py":[["hǎo","yǔ","zhī","shí","jié","dāng","chūn","nǎi","fā","shēng"],["suí","fēng","qián","rù","yè","rùn","wù","xì","wú","shēng"],["yě","jìng","yún","jù","hēi","jiāng","chuán","huǒ","dú","míng"],["xiǎo","kàn","hóng","shī","chù","huā","zhòng","jǐn","guān","chéng"]]},{"id":"6b-11","book":"6b","lesson":"6b-r","page":114,"src":"诵读","title":"早春呈水部张十八员外","titlePy":"zǎo chūn chéng shuǐ bù zhāng shí bā yuán wài","author":"韩愈","authorPy":"hán yù","dynasty":"唐","type":"诗","preface":null,"lines":["天街小雨润如酥，","草色遥看近却无。","最是一年春好处，","绝胜烟柳满皇都。"],"py":[["tiān","jiē","xiǎo","yǔ","rùn","rú","sū"],["cǎo","sè","yáo","kàn","jìn","què","wú"],["zuì","shì","yī","nián","chūn","hǎo","chù"],["jué","shèng","yān","liǔ","mǎn","huáng","dū"]]},{"id":"6b-12","book":"6b","lesson":"6b-r","page":115,"src":"诵读","title":"江上渔者","titlePy":"jiāng shàng yú zhě","author":"范仲淹","authorPy":"fàn zhòng yān","dynasty":"宋","type":"诗","preface":null,"lines":["江上往来人，","但爱鲈鱼美。","君看一叶舟，","出没风波里。"],"py":[["jiāng","shàng","wǎng","lái","rén"],["dàn","ài","lú","yú","měi"],["jūn","kàn","yī","yè","zhōu"],["chū","mò","fēng","bō","lǐ"]]},{"id":"6b-13","book":"6b","lesson":"6b-r","page":116,"src":"诵读","title":"泊船瓜洲","titlePy":"bó chuán guā zhōu","author":"王安石","authorPy":"wáng ān shí","dynasty":"宋","type":"诗","preface":null,"lines":["京口瓜洲一水间，","钟山只隔数重山。","春风又绿江南岸，","明月何时照我还。"],"py":[["jīng","kǒu","guā","zhōu","yī","shuǐ","jiān"],["zhōng","shān","zhǐ","gé","shù","chóng","shān"],["chūn","fēng","yòu","lǜ","jiāng","nán","àn"],["míng","yuè","hé","shí","zhào","wǒ","huán"]]},{"id":"6b-14","book":"6b","lesson":"6b-r","page":117,"src":"诵读","title":"游园不值","titlePy":"yóu yuán bù zhí","author":"叶绍翁","authorPy":"yè shào wēng","dynasty":"宋","type":"诗","preface":null,"lines":["应怜屐齿印苍苔，","小扣柴扉久不开。","春色满园关不住，","一枝红杏出墙来。"],"py":[["yīng","lián","jī","chǐ","yìn","cāng","tái"],["xiǎo","kòu","chái","fēi","jiǔ","bù","kāi"],["chūn","sè","mǎn","yuán","guān","bú","zhù"],["yī","zhī","hóng","xìng","chū","qiáng","lái"]]},{"id":"6b-15","book":"6b","lesson":"6b-r","page":118,"src":"诵读","title":"卜算子·送鲍浩然之浙东","titlePy":"bǔ suàn zǐ · sòng bào hào rán zhī zhè dōng","author":"王观","authorPy":"wáng guān","dynasty":"宋","type":"词","preface":null,"lines":["水是眼波横，山是眉峰聚。","欲问行人去那边？眉眼盈盈处。","才始送春归，又送君归去。","若到江南赶上春，千万和春住。"],"py":[["shuǐ","shì","yǎn","bō","héng","shān","shì","méi","fēng","jù"],["yù","wèn","xíng","rén","qù","nǎ","biān","méi","yǎn","yíng","yíng","chù"],["cái","shǐ","sòng","chūn","guī","yòu","sòng","jūn","guī","qù"],["ruò","dào","jiāng","nán","gǎn","shàng","chūn","qiān","wàn","hé","chūn","zhù"]]},{"id":"6b-16","book":"6b","lesson":"6b-r","page":119,"src":"诵读","title":"浣溪沙","titlePy":"huàn xī shā","author":"苏轼","authorPy":"sū shì","dynasty":"宋","type":"词","preface":"游蕲水清泉寺，寺临兰溪，溪水西流。","lines":["山下兰芽短浸溪，松间沙路净无泥。萧萧暮雨子规啼。","谁道人生无再少？门前流水尚能西！休将白发唱黄鸡。"],"py":[["shān","xià","lán","yá","duǎn","jìn","xī","sōng","jiān","shā","lù","jìng","wú","ní","xiāo","xiāo","mù","yǔ","zi","guī","tí"],["shuí","dào","rén","shēng","wú","zài","shào","mén","qián","liú","shuǐ","shàng","néng","xī","xiū","jiāng","bái","fà","chàng","huáng","jī"]]},{"id":"6b-17","book":"6b","lesson":"6b-r","page":120,"src":"诵读","title":"清平乐","titlePy":"qīng píng yuè","author":"黄庭坚","authorPy":"huáng tíng jiān","dynasty":"宋","type":"词","preface":null,"lines":["春归何处？寂寞无行路。","若有人知春去处，唤取归来同住。","春无踪迹谁知？除非问取黄鹂。","百啭无人能解，因风飞过蔷薇。"],"py":[["chūn","guī","hé","chù","jì","mò","wú","xíng","lù"],["ruò","yǒu","rén","zhī","chūn","qù","chù","huàn","qǔ","guī","lái","tóng","zhù"],["chūn","wú","zōng","jì","shuí","zhī","chú","fēi","wèn","qǔ","huáng","lí"],["bǎi","zhuàn","wú","rén","néng","jiě","yīn","fēng","fēi","guò","qiáng","wēi"]]}]